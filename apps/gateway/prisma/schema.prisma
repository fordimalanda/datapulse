// apps/gateway/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ProcessDataResult {
  id              String   @id @default(uuid())
  datasetId       String   @map("dataset_id")
  mean            Float
  min             Float
  max             Float
  processedValues Float[]  @map("processed_values")
  timeframe       String   @default("1h")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("process_data_results")
}

model MetricEntry {
  id         String   @id @default(uuid())
  metricType String   @map("metric_type")
  value      Float
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([metricType, timestamp])
  @@map("metric_entries")
}